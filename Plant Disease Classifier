        "\n",
        "# ================================================================\n",
        "# 34. PREDICTION FUNCTION\n",
        "# ================================================================\n",
        "\n",
        "def predict_image(\n",
        "\n",
        "    image,\n",
        "\n",
        "    top_k=5\n",
        "\n",
        "):\n",
        "\n",
        "\n",
        "    if image is None:\n",
        "\n",
        "        return {\n",
        "\n",
        "            \"Please upload an image\": 1.0\n",
        "\n",
        "        }\n",
        "\n",
        "\n",
        "    if isinstance(\n",
        "\n",
        "        image,\n",
        "\n",
        "        np.ndarray\n",
        "\n",
        "    ):\n",
        "\n",
        "        image = Image.fromarray(\n",
        "\n",
        "            image.astype(\n",
        "                np.uint8\n",
        "            )\n",
        "\n",
        "        )\n",
        "\n",
        "\n",
        "    image = image.convert(\n",
        "        \"RGB\"\n",
        "    )\n",
        "\n",
        "\n",
        "    tensor = inference_transform(\n",
        "        image\n",
        "    )\n",
        "\n",
        "\n",
        "    tensor = tensor.unsqueeze(\n",
        "        0\n",
        "    )\n",
        "\n",
        "\n",
        "    tensor = tensor.to(\n",
        "        device\n",
        "    )\n",
        "\n",
        "\n",
        "    with torch.no_grad():\n",
        "\n",
        "        outputs = model(\n",
        "            tensor\n",
        "        )\n",
        "\n",
        "\n",
        "        probabilities = torch.softmax(\n",
        "\n",
        "            outputs,\n",
        "\n",
        "            dim=1\n",
        "\n",
        "        )\n",
        "\n",
        "\n",
        "    probabilities = probabilities[0]\n",
        "\n",
        "\n",
        "    k = min(\n",
        "\n",
        "        top_k,\n",
        "\n",
        "        len(class_names)\n",
        "\n",
        "    )\n",
        "\n",
        "\n",
        "    top_probabilities, top_indices = torch.topk(\n",
        "\n",
        "        probabilities,\n",
        "\n",
        "        k=k\n",
        "\n",
        "    )\n",
        "\n",
        "\n",
        "    results = {}\n",
        "\n",
        "\n",
        "    for probability, index in zip(\n",
        "\n",
        "        top_probabilities.cpu().tolist(),\n",
        "\n",
        "        top_indices.cpu().tolist()\n",
        "\n",
        "    ):\n",
        "\n",
        "\n",
        "        results[\n",
        "\n",
        "            class_names[index]\n",
        "\n",
        "        ] = float(\n",
        "            probability\n",
        "        )\n",
        "\n",
        "\n",
        "    return results\n",
        "\n",
