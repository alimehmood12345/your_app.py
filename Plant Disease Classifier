        "# ================================================================\n",
        "# 🌿 PLANT DISEASE CLASSIFICATION - COMPLETE COLAB CODE\n",
        "# ================================================================\n",
        "#\n",
        "# Dataset: PlantVillage\n",
        "# Model: ResNet50 Transfer Learning\n",
        "# Classes: 38\n",
        "# Framework: PyTorch\n",
        "# Platform: Google Colab\n",
        "#\n",
        "# Includes:\n",
        "#   ✓ CUDA compatibility test\n",
        "#   ✓ Automatic CPU fallback\n",
        "#   ✓ PlantVillage download\n",
        "#   ✓ Automatic dataset detection\n",
        "#   ✓ Stratified train/validation split\n",
        "#   ✓ Data augmentation\n",
        "#   ✓ Pretrained ResNet50\n",
        "#   ✓ Transfer learning\n",
        "#   ✓ Mixed precision when CUDA works\n",
        "#   ✓ Training\n",
        "#   ✓ Validation\n",
        "#   ✓ Accuracy\n",
        "#   ✓ Classification report\n",
        "#   ✓ Confusion matrix\n",
        "#   ✓ Model saving\n",
        "#   ✓ Class-name saving\n",
        "#   ✓ Test prediction\n",
        "#   ✓ Gradio web application\n",
        "#\n",
        "# ================================================================\n",
        "\n",
        "\n",
        "# ================================================================\n",
        "# 1. INSTALL LIBRARIES\n",
        "# ================================================================\n",
        "\n",
        "!pip -q install -U torch torchvision torchaudio\n",
        "!pip -q install kagglehub gradio scikit-learn matplotlib seaborn tqdm\n",
        "\n",
        "\n",
        "# ================================================================\n",
        "# 2. IMPORT LIBRARIES\n",
        "# ================================================================\n",
        "\n",
        "import os\n",
        "import json\n",
        "import random\n",
        "import time\n",
        "from pathlib import Path\n",
        "from collections import Counter\n",
        "\n",
        "import numpy as np\n",
        "import matplotlib.pyplot as plt\n",
        "import seaborn as sns\n",
        "\n",
        "from PIL import Image\n",
        "\n",
        "import torch\n",
        "import torch.nn as nn\n",
        "\n",
        "from torch.utils.data import DataLoader, Subset\n",
        "\n",
        "from torchvision import datasets, transforms\n",
        "\n",
        "from torchvision.models import (\n",
        "    resnet50,\n",
        "    ResNet50_Weights\n",
        ")\n",
        "\n",
        "from sklearn.model_selection import train_test_split\n",
        "\n",
        "from sklearn.metrics import (\n",
        "    classification_report,\n",
        "    confusion_matrix,\n",
        "    accuracy_score\n",
        ")\n",
        "\n",
        "from tqdm.auto import tqdm\n",
        "\n",
        "import kagglehub\n",
        "import gradio as gr\n",
        "\n",
        "\n",
        "# ================================================================\n",
        "# 3. CONFIGURATION\n",
        "# ================================================================\n",
        "\n",
        "SEED = 42\n",
        "\n",
        "IMAGE_SIZE = 224\n",
        "\n",
        "BATCH_SIZE = 32\n",
        "\n",
        "EPOCHS = 5\n",
        "\n",
        "LEARNING_RATE = 1e-3\n",
        "\n",
        "WEIGHT_DECAY = 1e-4\n",
        "\n",
        "VAL_SIZE = 0.20\n",
        "\n",
        "NUM_WORKERS = 2\n",
        "\n",
        "EXPECTED_CLASSES = 38\n",
        "\n",
        "MODEL_PATH = \"/content/plant_disease_resnet50.pth\"\n",
        "\n",
        "CLASS_NAMES_PATH = \"/content/plant_disease_classes.json\"\n",
        "\n",
        "\n",
        "# ================================================================\n",
        "# 4. REPRODUCIBILITY\n",
        "# ================================================================\n",
        "\n",
        "def set_seed(seed=42):\n",
        "\n",
        "    random.seed(seed)\n",
        "\n",
        "    np.random.seed(seed)\n",
        "\n",
        "    torch.manual_seed(seed)\n",
        "\n",
        "    if torch.cuda.is_available():\n",
        "\n",
        "        torch.cuda.manual_seed(seed)\n",
        "\n",
        "        torch.cuda.manual_seed_all(seed)\n",
        "\n",
        "    torch.backends.cudnn.deterministic = True\n",
        "\n",
        "    torch.backends.cudnn.benchmark = False\n",
        "\n",
        "\n",
        "set_seed(SEED)\n",
        "\n",
        "\n",
        "# ================================================================\n",
        "# 5. CUDA COMPATIBILITY TEST\n",
        "# ================================================================\n",
        "\n",
        "print(\"=\" * 70)\n",
        "print(\"CHECKING PYTORCH / CUDA\")\n",
        "print(\"=\" * 70)\n",
        "\n",
        "print(\"PyTorch version:\", torch.__version__)\n",
        "\n",
        "print(\"Torchvision version:\", __import__(\"torchvision\").__version__)\n",
        "\n",
        "print(\"CUDA version:\", torch.version.cuda)\n",
        "\n",
        "print(\n",
        "    \"CUDA available:\",\n",
        "    torch.cuda.is_available()\n",
        ")\n",
        "\n",
        "\n",
        "CUDA_WORKING = False\n",
        "\n",
        "\n",
        "if torch.cuda.is_available():\n",
        "\n",
        "    try:\n",
        "\n",
        "        gpu_name = torch.cuda.get_device_name(0)\n",
        "\n",
        "        print(\"GPU:\", gpu_name)\n",
        "\n",
        "        print(\"Testing CUDA...\")\n",
        "\n",
        "        test_tensor = torch.randn(\n",
        "            2,\n",
        "            3,\n",
        "            224,\n",
        "            224,\n",
        "            device=\"cuda\"\n",
        "        )\n",
        "\n",
        "\n",
        "        test_conv = nn.Conv2d(\n",
        "            3,\n",
        "            16,\n",
        "            kernel_size=3,\n",
        "            padding=1\n",
        "        ).cuda()\n",
        "\n",
        "\n",
        "        with torch.no_grad():\n",
        "\n",
        "            test_output = test_conv(\n",
        "                test_tensor\n",
        "            )\n",
        "\n",
        "\n",
        "        torch.cuda.synchronize()\n",
        "\n",
        "\n",
        "        print(\"CUDA TEST: PASSED\")\n",
        "\n",
        "        CUDA_WORKING = True\n",
        "\n",
        "\n",
        "    except Exception as e:\n",
        "\n",
        "        print(\"CUDA TEST: FAILED\")\n",
        "\n",
        "        print(\"CUDA error:\")\n",
        "\n",
        "        print(str(e))\n",
        "\n",
        "        print()\n",
        "\n",
        "        print(\n",
        "            \"The current PyTorch CUDA build is \"\n",
        "            \"not compatible with this GPU.\"\n",
        "        )\n",
        "\n",
        "        print(\n",
        "            \"The notebook will automatically use CPU.\"\n",
        "        )\n",
        "\n",
        "        CUDA_WORKING = False\n",
        "\n",
        "\n",
        "if CUDA_WORKING:\n",
        "\n",
        "    device = torch.device(\"cuda\")\n",
        "\n",
        "else:\n",
        "\n",
        "    device = torch.device(\"cpu\")\n",
        "\n",
        "\n",
        "print()\n",
        "\n",
        "print(\"=\" * 70)\n",
        "\n",
        "print(\"USING DEVICE:\", device)\n",
        "\n",
        "if CUDA_WORKING:\n",
        "\n",
        "    print(\n",
        "        \"GPU:\",\n",
        "        torch.cuda.get_device_name(0)\n",
        "    )\n",
        "\n",
        "print(\"=\" * 70)\n",
        "\n",
        "\n",
        "# ================================================================\n",
        "# 6. DOWNLOAD PLANTVILLAGE DATASET\n",
        "# ================================================================\n",
        "\n",
        "print()\n",
        "\n",
        "print(\"=\" * 70)\n",
        "print(\"DOWNLOADING PLANTVILLAGE DATASET\")\n",
        "print(\"=\" * 70)\n",
        "\n",
        "dataset_path = kagglehub.dataset_download(\n",
        "    \"abdallahalidev/plantvillage-dataset\"\n",
        ")\n",
        "\n",
        "dataset_path = Path(\n",
        "    dataset_path\n",
        ")\n",
        "\n",
        "print()\n",
        "\n",
        "print(\"Dataset downloaded to:\")\n",
        "\n",
        "print(dataset_path)\n",
        "\n",
        "\n",
        "# ================================================================\n",
        "# 7. FIND DATASET ROOT AUTOMATICALLY\n",
        "# ================================================================\n",
        "\n",
        "print()\n",
        "\n",
        "print(\"=\" * 70)\n",
        "print(\"SEARCHING FOR IMAGEFOLDER\")\n",
        "print(\"=\" * 70)\n",
        "\n",
        "\n",
        "candidate_roots = []\n",
        "\n",
        "\n",
        "for root in [dataset_path] + list(\n",
        "    dataset_path.rglob(\"*\")\n",
        "):\n",
        "\n",
        "    if not root.is_dir():\n",
        "\n",
        "        continue\n",
        "\n",
        "\n",
        "    try:\n",
        "\n",
        "        subdirs = [\n",
        "            d\n",
        "            for d in root.iterdir()\n",
        "            if d.is_dir()\n",
        "        ]\n",
        "\n",
        "    except Exception:\n",
        "\n",
        "        continue\n",
        "\n",
        "\n",
        "    if len(subdirs) < 30:\n",
        "\n",
        "        continue\n",
        "\n",
        "\n",
        "    image_count = 0\n",
        "\n",
        "\n",
        "    for subdir in subdirs:\n",
        "\n",
        "        try:\n",
        "\n",
        "            for file in subdir.iterdir():\n",
        "\n",
        "                if file.suffix.lower() in [\n",
        "\n",
        "                    \".jpg\",\n",
        "                    \".jpeg\",\n",
        "                    \".png\",\n",
        "                    \".bmp\",\n",
        "                    \".webp\"\n",
        "\n",
        "                ]:\n",
        "\n",
        "                    image_count += 1\n",
        "\n",
        "        except Exception:\n",
        "\n",
        "            pass\n",
        "\n",
        "\n",
        "    candidate_roots.append(\n",
        "\n",
        "        (\n",
        "            len(subdirs),\n",
        "            image_count,\n",
        "            root\n",
        "        )\n",
        "\n",
        "    )\n",
        "\n",
        "\n",
        "if len(candidate_roots) == 0:\n",
        "\n",
        "    raise RuntimeError(\n",
        "        \"Could not find the PlantVillage \"\n",
        "        \"ImageFolder directory.\"\n",
        "    )\n",
        "\n",
        "\n",
        "# Prefer exactly 38 classes\n",
        "\n",
        "exact_38 = [\n",
        "\n",
        "    item\n",
        "    for item in candidate_roots\n",
        "    if item[0] == EXPECTED_CLASSES\n",
        "\n",
        "]\n",
        "\n",
        "\n",
        "if len(exact_38) > 0:\n",
        "\n",
        "    exact_38.sort(\n",
        "        key=lambda x: x[1],\n",
        "        reverse=True\n",
        "    )\n",
        "\n",
        "    data_root = exact_38[0][2]\n",
        "\n",
        "else:\n",
        "\n",
        "    candidate_roots.sort(\n",
        "        key=lambda x: x[1],\n",
        "        reverse=True\n",
        "    )\n",
        "\n",
        "    data_root = candidate_roots[0][2]\n",
        "\n",
        "\n",
        "print()\n",
        "\n",
        "print(\"Selected dataset root:\")\n",
        "\n",
        "print(data_root)\n",
        "\n",
        "\n",
        "# ================================================================\n",
        "# 8. DATA AUGMENTATION\n",
        "# ================================================================\n",
        "\n",
        "train_transform = transforms.Compose([\n",
        "\n",
        "    transforms.Resize(\n",
        "        (IMAGE_SIZE, IMAGE_SIZE)\n",
        "    ),\n",
        "\n",
        "    transforms.RandomHorizontalFlip(\n",
        "        p=0.5\n",
        "    ),\n",
        "\n",
        "    transforms.RandomVerticalFlip(\n",
        "        p=0.2\n",
        "    ),\n",
        "\n",
        "    transforms.RandomRotation(\n",
        "        degrees=20\n",
        "    ),\n",
        "\n",
        "    transforms.ColorJitter(\n",
        "        brightness=0.2,\n",
        "        contrast=0.2,\n",
        "        saturation=0.2,\n",
        "        hue=0.05\n",
        "    ),\n",
        "\n",
        "    transforms.ToTensor(),\n",
        "\n",
        "    transforms.Normalize(\n",
        "\n",
        "        mean=[\n",
        "            0.485,\n",
        "            0.456,\n",
        "            0.406\n",
        "        ],\n",
        "\n",
        "        std=[\n",
        "            0.229,\n",
        "            0.224,\n",
        "            0.225\n",
        "        ]\n",
        "\n",
        "    )\n",
        "\n",
        "])\n",
        "\n",
        "\n",
        "val_transform = transforms.Compose([\n",
        "\n",
        "    transforms.Resize(\n",
        "        (IMAGE_SIZE, IMAGE_SIZE)\n",
        "    ),\n",
        "\n",
        "    transforms.ToTensor(),\n",
        "\n",
        "    transforms.Normalize(\n",
        "\n",
        "        mean=[\n",
        "            0.485,\n",
        "            0.456,\n",
        "            0.406\n",
        "        ],\n",
        "\n",
        "        std=[\n",
        "            0.229,\n",
        "            0.224,\n",
        "            0.225\n",
        "        ]\n",
        "\n",
        "    )\n",
        "\n",
        "])\n",
        "\n",
        "\n",
        "# ================================================================\n",
        "# 9. LOAD DATASET\n",
        "# ================================================================\n",
        "\n",
        "print()\n",
        "\n",
        "print(\"=\" * 70)\n",
        "print(\"LOADING DATASET\")\n",
        "print(\"=\" * 70)\n",
        "\n",
        "\n",
        "train_dataset_full = datasets.ImageFolder(\n",
        "\n",
        "    root=str(data_root),\n",
        "\n",
        "    transform=train_transform\n",
        "\n",
        ")\n",
        "\n",
        "\n",
        "val_dataset_full = datasets.ImageFolder(\n",
        "\n",
        "    root=str(data_root),\n",
        "\n",
        "    transform=val_transform\n",
        "\n",
        ")\n",
        "\n",
        "\n",
        "class_names = train_dataset_full.classes\n",
        "\n",
        "targets = np.array(\n",
        "    train_dataset_full.targets\n",
        ")\n",
        "\n",
        "\n",
        "num_classes = len(\n",
        "    class_names\n",
        ")\n",
        "\n",
        "\n",
        "print()\n",
        "\n",
        "print(\n",
        "    \"Number of classes:\",\n",
        "    num_classes\n",
        ")\n",
        "\n",
        "\n",
        "if num_classes != EXPECTED_CLASSES:\n",
        "\n",
        "    print()\n",
        "\n",
        "    print(\n",
        "        \"WARNING: Expected\",\n",
        "        EXPECTED_CLASSES,\n",
        "        \"classes but found\",\n",
        "        num_classes\n",
        "    )\n",
        "\n",
        "\n",
        "print()\n",
        "\n",
        "print(\"Classes:\")\n",
        "\n",
        "for i, class_name in enumerate(\n",
        "    class_names\n",
        "):\n",
        "\n",
        "    print(\n",
        "        f\"{i:02d}: {class_name}\"\n",
        "    )\n",
        "\n",
        "\n",
        "# ================================================================\n",
        "# 10. DATASET DISTRIBUTION\n",
        "# ================================================================\n",
        "\n",
        "print()\n",
        "\n",
        "print(\"=\" * 70)\n",
        "print(\"DATASET DISTRIBUTION\")\n",
        "print(\"=\" * 70)\n",
        "\n",
        "\n",
        "class_distribution = Counter(\n",
        "    targets\n",
        ")\n",
        "\n",
        "\n",
        "for index, class_name in enumerate(\n",
        "    class_names\n",
        "):\n",
        "\n",
        "    print(\n",
        "        f\"{class_name:55s}\"\n",
        "        f\"{class_distribution[index]}\"\n",
        "    )\n",
        "\n",
        "\n",
        "print()\n",
        "\n",
        "print(\n",
        "    \"Total images:\",\n",
        "    len(train_dataset_full)\n",
        ")\n",
        "\n",
        "\n",
        "# ================================================================\n",
        "# 11. TRAIN / VALIDATION SPLIT\n",
        "# ================================================================\n",
        "\n",
        "print()\n",
        "\n",
        "print(\"=\" * 70)\n",
        "print(\"CREATING TRAIN / VALIDATION SPLIT\")\n",
        "print(\"=\" * 70)\n",
        "\n",
        "\n",
        "indices = np.arange(\n",
        "    len(train_dataset_full)\n",
        ")\n",
        "\n",
        "\n",
        "train_indices, val_indices = train_test_split(\n",
        "\n",
        "    indices,\n",
        "\n",
        "    test_size=VAL_SIZE,\n",
        "\n",
        "    random_state=SEED,\n",
        "\n",
        "    stratify=targets\n",
        "\n",
        ")\n",
        "\n",
        "\n",
        "print()\n",
        "\n",
        "print(\n",
        "    \"Training images:\",\n",
        "    len(train_indices)\n",
        ")\n",
        "\n",
        "print(\n",
        "    \"Validation images:\",\n",
        "    len(val_indices)\n",
        ")\n",
        "\n",
        "\n",
        "# ================================================================\n",
        "# 12. DATASET SUBSETS\n",
        "# ================================================================\n",
        "\n",
        "train_dataset = Subset(\n",
        "\n",
        "    train_dataset_full,\n",
        "\n",
        "    train_indices\n",
        "\n",
        ")\n",
        "\n",
        "\n",
        "val_dataset = Subset(\n",
        "\n",
        "    val_dataset_full,\n",
        "\n",
        "    val_indices\n",
        "\n",
        ")\n",
        "\n",
        "\n",
        "# ================================================================\n",
        "# 13. DATA LOADERS\n",
        "# ================================================================\n",
        "\n",
        "train_loader = DataLoader(\n",
        "\n",
        "    train_dataset,\n",
        "\n",
        "    batch_size=BATCH_SIZE,\n",
        "\n",
        "    shuffle=True,\n",
        "\n",
        "    num_workers=NUM_WORKERS,\n",
        "\n",
        "    pin_memory=CUDA_WORKING\n",
        "\n",
        ")\n",
        "\n",
        "\n",
        "val_loader = DataLoader(\n",
        "\n",
        "    val_dataset,\n",
        "\n",
        "    batch_size=BATCH_SIZE,\n",
        "\n",
        "    shuffle=False,\n",
        "\n",
        "    num_workers=NUM_WORKERS,\n",
        "\n",
        "    pin_memory=CUDA_WORKING\n",
        "\n",
        ")\n",
        "\n",
        "\n",
        "print()\n",
        "\n",
        "print(\n",
        "    \"Train batches:\",\n",
        "    len(train_loader)\n",
        ")\n",
        "\n",
        "print(\n",
        "    \"Validation batches:\",\n",
        "    len(val_loader)\n",
        ")\n",
        "\n",
        "\n",
        "# ================================================================\n",
        "# 14. SHOW SAMPLE IMAGES\n",
        "# ================================================================\n",
        "\n",
        "def denormalize(image):\n",
        "\n",
        "    mean = torch.tensor(\n",
        "\n",
        "        [\n",
        "            0.485,\n",
        "            0.456,\n",
        "            0.406\n",
        "        ]\n",
        "\n",
        "    ).view(\n",
        "        3,\n",
        "        1,\n",
        "        1\n",
        "    )\n",
        "\n",
        "\n",
        "    std = torch.tensor(\n",
        "\n",
        "        [\n",
        "            0.229,\n",
        "            0.224,\n",
        "            0.225\n",
        "        ]\n",
        "\n",
        "    ).view(\n",
        "        3,\n",
        "        1,\n",
        "        1\n",
        "    )\n",
        "\n",
        "\n",
        "    image = image.cpu() * std + mean\n",
        "\n",
        "\n",
        "    return torch.clamp(\n",
        "        image,\n",
        "        0,\n",
        "        1\n",
        "    )\n",
        "\n",
        "\n",
        "images, labels = next(\n",
        "    iter(train_loader)\n",
        ")\n",
        "\n",
        "\n",
        "plt.figure(\n",
        "    figsize=(14, 10)\n",
        ")\n",
        "\n",
        "\n",
        "for i in range(\n",
        "    min(12, len(images))\n",
        "):\n",
        "\n",
        "    plt.subplot(\n",
        "        3,\n",
        "        4,\n",
        "        i + 1\n",
        "    )\n",
        "\n",
        "\n",
        "    image = denormalize(\n",
        "        images[i]\n",
        "    )\n",
        "\n",
        "\n",
        "    plt.imshow(\n",
        "        image.permute(\n",
        "            1,\n",
        "            2,\n",
        "            0\n",
        "        )\n",
        "    )\n",
        "\n",
        "\n",
        "    plt.title(\n",
        "        class_names[\n",
        "            labels[i]\n",
        "        ]\n",
        "    )\n",
        "\n",
        "\n",
        "    plt.axis(\n",
        "        \"off\"\n",
        "    )\n",
        "\n",
        "\n",
        "plt.tight_layout()\n",
        "\n",
        "plt.show()\n",
        "\n",
        "\n",
        "# ================================================================\n",
        "# 15. LOAD PRETRAINED RESNET50\n",
        "# ================================================================\n",
        "\n",
        "print()\n",
        "\n",
        "print(\"=\" * 70)\n",
        "print(\"LOADING PRETRAINED RESNET50\")\n",
        "print(\"=\" * 70)\n",
        "\n",
        "\n",
        "weights = ResNet50_Weights.DEFAULT\n",
        "\n",
        "\n",
        "model = resnet50(\n",
        "    weights=weights\n",
        ")\n",
        "\n",
        "\n",
        "# ================================================================\n",
        "# 16. FREEZE BACKBONE\n",
        "# ================================================================\n",
        "\n",
        "for parameter in model.parameters():\n",
        "\n",
        "    parameter.requires_grad = False\n",
        "\n",
        "\n",
        "# ================================================================\n",
        "# 17. REPLACE FINAL CLASSIFIER\n",
        "# ================================================================\n",
        "\n",
        "input_features = model.fc.in_features\n",
        "\n",
        "\n",
        "model.fc = nn.Sequential(\n",
        "\n",
        "    nn.Dropout(\n",
        "        p=0.30\n",
        "    ),\n",
        "\n",
        "    nn.Linear(\n",
        "        input_features,\n",
        "        num_classes\n",
        "    )\n",
        "\n",
        ")\n",
        "\n",
        "\n",
        "model = model.to(\n",
        "    device\n",
        ")\n",
        "\n",
        "\n",
        "# ================================================================\n",
        "# 18. PARAMETER INFORMATION\n",
        "# ================================================================\n",
        "\n",
        "total_parameters = sum(\n",
        "\n",
        "    p.numel()\n",
        "\n",
        "    for p in model.parameters()\n",
        "\n",
        ")\n",
        "\n",
        "\n",
        "trainable_parameters = sum(\n",
        "\n",
        "    p.numel()\n",
        "\n",
        "    for p in model.parameters()\n",
        "\n",
        "    if p.requires_grad\n",
        "\n",
        ")\n",
        "\n",
        "\n",
        "print()\n",
        "\n",
        "print(\n",
        "    \"Total parameters:\",\n",
        "    f\"{total_parameters:,}\"\n",
        ")\n",
        "\n",
        "print(\n",
        "    \"Trainable parameters:\",\n",
        "    f\"{trainable_parameters:,}\"\n",
        ")\n",
        "\n",
        "\n",
        "# ================================================================\n",
        "# 19. LOSS\n",
        "# ================================================================\n",
        "\n",
        "criterion = nn.CrossEntropyLoss(\n",
        "\n",
        "    label_smoothing=0.05\n",
        "\n",
        ")\n",
        "\n",
        "\n",
        "# ================================================================\n",
        "# 20. OPTIMIZER\n",
        "# ================================================================\n",
        "\n",
        "optimizer = torch.optim.AdamW(\n",
        "\n",
        "    model.fc.parameters(),\n",
        "\n",
        "    lr=LEARNING_RATE,\n",
        "\n",
        "    weight_decay=WEIGHT_DECAY\n",
        "\n",
        ")\n",
        "\n",
        "\n",
        "# ================================================================\n",
        "# 21. SCHEDULER\n",
        "# ================================================================\n",
        "\n",
        "scheduler = torch.optim.lr_scheduler.CosineAnnealingLR(\n",
        "\n",
        "    optimizer,\n",
        "\n",
        "    T_max=EPOCHS\n",
        "\n",
        ")\n",
        "\n",
        "\n",
        "# ================================================================\n",
        "# 22. MIXED PRECISION\n",
        "# ================================================================\n",
        "\n",
        "use_amp = CUDA_WORKING\n",
        "\n",
        "\n",
        "if use_amp:\n",
        "\n",
        "    scaler = torch.amp.GradScaler(\n",
        "        \"cuda\"\n",
        "    )\n",
        "\n",
        "else:\n",
        "\n",
        "    scaler = None\n",
        "\n",
        "\n",
        "# ================================================================\n",
        "# 23. TRAINING FUNCTION\n",
        "# ================================================================\n",
        "\n",
        "def train_one_epoch(\n",
        "\n",
        "    model,\n",
        "    loader,\n",
        "    criterion,\n",
        "    optimizer\n",
        "\n",
        "):\n",
        "\n",
        "    model.train()\n",
        "\n",
        "\n",
        "    running_loss = 0.0\n",
        "\n",
        "    correct = 0\n",
        "\n",
        "    total = 0\n",
        "\n",
        "\n",
        "    progress = tqdm(\n",
        "\n",
        "        loader,\n",
        "\n",
        "        desc=\"Training\",\n",
        "\n",
        "        leave=False\n",
        "\n",
        "    )\n",
        "\n",
        "\n",
        "    for images, labels in progress:\n",
        "\n",
        "\n",
        "        images = images.to(\n",
        "\n",
        "            device,\n",
        "\n",
        "            non_blocking=CUDA_WORKING\n",
        "\n",
        "        )\n",
        "\n",
        "\n",
        "        labels = labels.to(\n",
        "\n",
        "            device,\n",
        "\n",
        "            non_blocking=CUDA_WORKING\n",
        "\n",
        "        )\n",
        "\n",
        "\n",
        "        optimizer.zero_grad(\n",
        "            set_to_none=True\n",
        "        )\n",
        "\n",
        "\n",
        "        if use_amp:\n",
        "\n",
        "            with torch.amp.autocast(\n",
        "\n",
        "                device_type=\"cuda\"\n",
        "\n",
        "            ):\n",
        "\n",
        "                outputs = model(\n",
        "                    images\n",
        "                )\n",
        "\n",
        "                loss = criterion(\n",
        "\n",
        "                    outputs,\n",
        "\n",
        "                    labels\n",
        "\n",
        "                )\n",
        "\n",
        "\n",
        "            scaler.scale(\n",
        "                loss\n",
        "            ).backward()\n",
        "\n",
        "\n",
        "            scaler.unscale_(\n",
        "                optimizer\n",
        "            )\n",
        "\n",
        "\n",
        "            torch.nn.utils.clip_grad_norm_(\n",
        "\n",
        "                model.parameters(),\n",
        "\n",
        "                max_norm=1.0\n",
        "\n",
        "            )\n",
        "\n",
        "\n",
        "            scaler.step(\n",
        "                optimizer\n",
        "            )\n",
        "\n",
        "\n",
        "            scaler.update()\n",
        "\n",
        "\n",
        "        else:\n",
        "\n",
        "            outputs = model(\n",
        "                images\n",
        "            )\n",
        "\n",
        "            loss = criterion(\n",
        "\n",
        "                outputs,\n",
        "\n",
        "                labels\n",
        "\n",
        "            )\n",
        "\n",
        "\n",
        "            loss.backward()\n",
        "\n",
        "\n",
        "            torch.nn.utils.clip_grad_norm_(\n",
        "\n",
        "                model.parameters(),\n",
        "\n",
        "                max_norm=1.0\n",
        "\n",
        "            )\n",
        "\n",
        "\n",
        "            optimizer.step()\n",
        "\n",
        "\n",
        "        running_loss += (\n",
        "\n",
        "            loss.item()\n",
        "            *\n",
        "            images.size(0)\n",
        "\n",
        "        )\n",
        "\n",
        "\n",
        "        predictions = outputs.argmax(\n",
        "            dim=1\n",
        "        )\n",
        "\n",
        "\n",
        "        correct += (\n",
        "\n",
        "            predictions == labels\n",
        "\n",
        "        ).sum().item()\n",
        "\n",
        "\n",
        "        total += labels.size(0)\n",
        "\n",
        "\n",
        "        progress.set_postfix(\n",
        "\n",
        "            loss=f\"{loss.item():.4f}\",\n",
        "\n",
        "            acc=f\"{100 * correct / total:.2f}%\"\n",
        "\n",
        "        )\n",
        "\n",
        "\n",
        "    epoch_loss = (\n",
        "\n",
        "        running_loss / total\n",
        "\n",
        "    )\n",
        "\n",
        "\n",
        "    epoch_accuracy = (\n",
        "\n",
        "        correct / total\n",
        "\n",
        "    )\n",
        "\n",
        "\n",
        "    return (\n",
        "\n",
        "        epoch_loss,\n",
        "\n",
        "        epoch_accuracy\n",
        "\n",
        "    )\n",
        "\n",
        "\n",
        "# ================================================================\n",
        "# 24. VALIDATION FUNCTION\n",
        "# ================================================================\n",
        "\n",
        "def validate(\n",
        "\n",
        "    model,\n",
        "    loader,\n",
        "    criterion\n",
        "\n",
        "):\n",
        "\n",
        "    model.eval()\n",
        "\n",
        "\n",
        "    running_loss = 0.0\n",
        "\n",
        "    correct = 0\n",
        "\n",
        "    total = 0\n",
        "\n",
        "\n",
        "    all_predictions = []\n",
        "\n",
        "    all_labels = []\n",
        "\n",
        "\n",
        "    with torch.no_grad():\n",
        "\n",
        "        for images, labels in tqdm(\n",
        "\n",
        "            loader,\n",
        "\n",
        "            desc=\"Validation\",\n",
        "\n",
        "            leave=False\n",
        "\n",
        "        ):\n",
        "\n",
        "\n",
        "            images = images.to(\n",
        "\n",
        "                device,\n",
        "\n",
        "                non_blocking=CUDA_WORKING\n",
        "\n",
        "            )\n",
        "\n",
        "\n",
        "            labels = labels.to(\n",
        "\n",
        "                device,\n",
        "\n",
        "                non_blocking=CUDA_WORKING\n",
        "\n",
        "            )\n",
        "\n",
        "\n",
        "            if use_amp:\n",
        "\n",
        "                with torch.amp.autocast(\n",
        "\n",
        "                    device_type=\"cuda\"\n",
        "\n",
        "                ):\n",
        "\n",
        "                    outputs = model(\n",
        "                        images\n",
        "                    )\n",
        "\n",
        "                    loss = criterion(\n",
        "\n",
        "                        outputs,\n",
        "\n",
        "                        labels\n",
        "\n",
        "                    )\n",
        "\n",
        "            else:\n",
        "\n",
        "                outputs = model(\n",
        "                    images\n",
        "                )\n",
        "\n",
        "                loss = criterion(\n",
        "\n",
        "                    outputs,\n",
        "\n",
        "                    labels\n",
        "\n",
        "                )\n",
        "\n",
        "\n",
        "            running_loss += (\n",
        "\n",
        "                loss.item()\n",
        "                *\n",
        "                images.size(0)\n",
        "\n",
        "            )\n",
        "\n",
        "\n",
        "            predictions = outputs.argmax(\n",
        "                dim=1\n",
        "            )\n",
        "\n",
        "\n",
        "            correct += (\n",
        "\n",
        "                predictions == labels\n",
        "\n",
        "            ).sum().item()\n",
        "\n",
        "\n",
        "            total += labels.size(0)\n",
        "\n",
        "\n",
        "            all_predictions.extend(\n",
        "\n",
        "                predictions.cpu().numpy()\n",
        "\n",
        "            )\n",
        "\n",
        "\n",
        "            all_labels.extend(\n",
        "\n",
        "                labels.cpu().numpy()\n",
        "\n",
        "            )\n",
        "\n",
        "\n",
        "    epoch_loss = (\n",
        "\n",
        "        running_loss / total\n",
        "\n",
        "    )\n",
        "\n",
        "\n",
        "    epoch_accuracy = (\n",
        "\n",
        "        correct / total\n",
        "\n",
        "    )\n",
        "\n",
        "\n",
        "    return (\n",
        "\n",
        "        epoch_loss,\n",
        "\n",
        "        epoch_accuracy,\n",
        "\n",
        "        all_labels,\n",
        "\n",
        "        all_predictions\n",
        "\n",
        "    )\n",
